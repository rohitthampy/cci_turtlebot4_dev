{
    "name": "cci turtlebot4",
    "dockerFile": "Dockerfile",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python", 
                "ms-vscode.cpptools"
            ],
            "settings": {
                "remote.autoForwardPorts": false,
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "runArgs": [
        "--network=host",
        "-e", "DISPLAY=${env:DISPLAY}",
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    },
    
    
    "workspaceMount": "source=${localWorkspaceFolder},target=/${localWorkspaceFolderBasename},type=bind",
    "workspaceFolder": "/${localWorkspaceFolderBasename}",

    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.bash_history,target=/home/ubuntu/.bash_history,type=bind"
    ],

    "postCreateCommand": "bash -c 'echo \"source /opt/ros/humble/setup.bash\" >> ~/.bashrc && export RMW_IMPLEMENTATION=rmw_fastrtps_cpp >> ~/.bashrc'"
}